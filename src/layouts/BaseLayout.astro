---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
/* Body text is Atkinson Hyperlegible Next, italics included. The mono is not its
   monospaced sibling: that shares the family's legibility-first letterforms, which
   look wrong in the uppercase micro-labels the site is full of and in code, where
   this one is drawn to be read. Both are variable, so the fractional weights in
   global.css are real rather than snapped. */
import '@fontsource-variable/atkinson-hyperlegible-next';
import '@fontsource-variable/atkinson-hyperlegible-next/wght-italic.css';
import '@fontsource-variable/jetbrains-mono';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { LINKS, SITE } from '../data/site';
import { OG_HEIGHT, OG_WIDTH, ogImagePath } from '../lib/og';

export interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative path to a social preview image. Defaults to the
   *  page's own generated card, at the path it is built to. */
  image?: string;
  /** Micro-label for the card, e.g. "v1.0, draft \u00b7 13 parts". Read by the build. */
  socialMeta?: string;
  /** What the card calls this page, when the page's own title is not it. */
  cardTitle?: string;
  /** What the card says this page is, when the description is not what belongs on a
   *  card that will outlive the build - project pages put live counts in theirs. */
  cardSummary?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  socialMeta,
  cardTitle,
  cardSummary,
  noindex = false,
  structuredData = [],
} = Astro.props;

const pageTitle = title ? `${title} - ${SITE.name}` : `${SITE.name} - ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const socialImage = new URL(image ?? ogImagePath(Astro.url.pathname), Astro.site ?? SITE.url).href;

const organisation = {
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  alternateName: SITE.shortName,
  url: SITE.url,
  description: SITE.description,
  foundingDate: SITE.founded,
  email: SITE.email,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE.url}/brand/ora-avatar.png`,
    width: 180,
    height: 180,
  },
  sameAs: [LINKS.github, LINKS.discord],
  subOrganization: [],
  knowsAbout: [
    'resin 3D printing',
    'MSLA',
    'open-source slicer software',
    'additive manufacturing',
  ],
};

const graph = [
  organisation,
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.name,
    description: SITE.description,
    publisher: { '@id': `${SITE.url}/#organization` },
    inLanguage: 'en',
  },
  ...structuredData,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/brand/ora-avatar.png" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} blog`} href={LINKS.rss} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    {/* What the page calls itself, and its micro-label, carried to the build for the
        social card. The <title> is not used: it ends in the site name, and the card
        already says that in its footer. This is the only thing on the page that is
        not in a tag the build can read for itself. */}
    <meta name="card:title" content={cardTitle ?? title ?? SITE.tagline} />
    {cardSummary && <meta name="card:summary" content={cardSummary} />}
    {socialMeta && <meta name="card:meta" content={socialMeta} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <meta name="theme-color" content="#ec4899" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#9333ea" media="(prefers-color-scheme: dark)" />

    <script is:inline>
      // Theme bootstrap: applied before the first paint, and written onto the
      // incoming document before every swap. A navigation copies the new
      // document's <html> attributes over the live ones, and the built page
      // carries no theme attribute, so without the second half every navigation
      // would land in the light theme.
      (() => {
        const preferred = () => {
          try {
            const stored = localStorage.getItem('ora-theme');
            if (stored === 'light' || stored === 'dark') return stored;
          } catch {
            /* storage unavailable - fall back to the system preference */
          }
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        };

        document.documentElement.dataset.theme = preferred();

        document.addEventListener('astro:before-swap', (event) => {
          event.newDocument.documentElement.dataset.theme = preferred();
        });
      })();
    </script>

    <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />

    <!-- Navigations swap the document inside a view transition instead of
         reloading it: the animation itself is in global.css, and every script on
         the site has to assume it may be running against a document that was
         swapped in (see the page-load notes in Header.astro and lib/live.ts).
         Without JavaScript the links are ordinary links. -->
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <BackToTop />

    <script is:inline>
      // Delegated from document rather than bound to the button: the header is
      // replaced on every navigation, so a listener on the element would die with
      // it. The theme itself lives on <html>, which the router does not replace.
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element) || !target.closest('[data-theme-toggle]')) return;

        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('ora-theme', next);
        } catch {
          /* storage unavailable - theme applies for this page view only */
        }
        document.dispatchEvent(new CustomEvent('ora:theme', { detail: next }));
      });
    </script>
    <!-- Live refresh of the build-time snapshot. src/lib/live.ts leaves the built
         numbers in place whenever the APIs cannot be reached. -->
    <script>
      import '../lib/live';
    </script>
    <slot name="scripts" />
  </body>
</html>
