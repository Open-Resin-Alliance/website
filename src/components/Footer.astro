---
import BrandMark from './BrandMark.astro';
import { LINKS, SITE } from '../data/site';
import { FEATURED_PROJECTS, projectSlug } from '../data/projects';
import { stats } from '../lib/stats';
import { formatDateLong, formatRelative } from '../lib/format';

const year = new Date().getFullYear();
const generated = new Date(stats.generatedAt);
---

<footer class="site-footer">
  <div class="shell">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a class="brand" href="/">
          <BrandMark size={30} />
          <span>{SITE.name}</span>
        </a>
        <p class="site-footer__blurb">{SITE.description}</p>
        <p class="mono muted">Established {formatDateLong(SITE.founded)}</p>
      </div>

      <nav class="site-footer__col" aria-label="Projects">
        <h2 class="site-footer__title">Projects</h2>
        <ul>
          {FEATURED_PROJECTS.map((project) => (
            <li><a href={`/projects/${projectSlug(project)}`}>{project.name}</a></li>
          ))}
          <li><a href="/projects">All projects</a></li>
        </ul>
      </nav>

      <nav class="site-footer__col" aria-label="Organisation">
        <h2 class="site-footer__title">Organisation</h2>
        <ul>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href={LINKS.rss}>RSS feed</a></li>
        </ul>
      </nav>

      <nav class="site-footer__col" aria-label="External">
        <h2 class="site-footer__title">Elsewhere</h2>
        <ul>
          <li><a href={LINKS.github} rel="noopener noreferrer" target="_blank">GitHub</a></li>
          <li><a href={LINKS.discord} rel="noopener noreferrer" target="_blank">Discord</a></li>
          <li><a href={LINKS.dragonfruitSite} rel="noopener noreferrer" target="_blank">dragonfruit-slicer.com</a></li>
          <li><a href={LINKS.email}>github@openresin.org</a></li>
        </ul>
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p class="muted">© {year} Open Resin Alliance. Projects are licensed individually — see each repository.</p>
      <p class="mono muted">
        Statistics generated {formatRelative(generated)} &middot;
        <a href={stats.org.url} rel="noopener noreferrer" target="_blank">GitHub source</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    padding: 3.5rem 0 2rem;
    border-top: 1px solid var(--border);
    background: var(--bg-sunken);
    font-size: 0.9375rem;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    max-width: 34ch;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 620;
    letter-spacing: -0.022em;
  }

  .site-footer__blurb {
    color: var(--muted);
    line-height: 1.6;
  }

  .site-footer__title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-2);
    margin-bottom: 0.9rem;
  }

  .site-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .site-footer__col a {
    color: var(--muted);
    transition: color 0.15s var(--ease);
  }

  .site-footer__col a:hover {
    color: var(--ink);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    justify-content: space-between;
    align-items: baseline;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.8125rem;
  }

  .site-footer__bottom a {
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 2px;
  }

  .site-footer__bottom a:hover {
    text-decoration-color: var(--brand-pink);
  }

  @media (max-width: 860px) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }
</style>
