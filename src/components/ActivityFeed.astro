---
import type { ActivityEntry } from '../lib/stats';
import { formatRelative } from '../lib/format';

interface Props {
  entries: ActivityEntry[];
  limit?: number;
}

const { entries, limit = 8 } = Astro.props;
const visible = entries.slice(0, limit);

const KIND_LABEL: Record<ActivityEntry['kind'], string> = {
  release: 'Release',
  push: 'Commits',
  create: 'Branch',
  pull_request: 'Pull request',
  issue: 'Issue',
  public: 'Public',
};
---

<ul class="feed">
  {
    visible.map((entry) => (
      <li class="feed__item">
        <span class:list={['feed__dot', `feed__dot--${entry.kind}`]} aria-hidden="true" />
        <div class="feed__body">
          <p class="feed__line">
            {entry.url ? (
              <a href={entry.url} rel="noopener noreferrer" target="_blank">
                <strong>{entry.repo}</strong>
              </a>
            ) : (
              <strong>{entry.repo}</strong>
            )}{' '}
            <span class="feed__title">{entry.title}</span>
            {entry.burst && entry.burst > 1 && <span class="feed__burst mono">×{entry.burst}</span>}
          </p>
          <p class="feed__meta mono">
            <span class="feed__kind">{KIND_LABEL[entry.kind]}</span>
            {entry.actor && <> &middot; {entry.actor}</>} &middot;{' '}
            <time datetime={entry.date}>{formatRelative(entry.date)}</time>
          </p>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .feed {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .feed__item {
    display: flex;
    gap: 0.85rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border);
  }

  .feed__item:last-child {
    border-bottom: 0;
  }

  .feed__dot {
    flex: 0 0 auto;
    inline-size: 7px;
    block-size: 7px;
    margin-top: 0.5rem;
    border-radius: 999px;
    background: var(--muted-2);
  }

  .feed__dot--release {
    background: var(--brand-magenta);
  }

  .feed__dot--push {
    background: var(--brand-amber);
  }

  .feed__dot--issue {
    background: #64748b;
  }

  .feed__dot--pull_request {
    background: #0ea5e9;
  }

  .feed__dot--create {
    background: #16a34a;
  }

  .feed__body {
    min-width: 0;
  }

  .feed__line {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-soft);
    overflow-wrap: anywhere;
  }

  .feed__line a:hover {
    color: var(--brand-magenta-deep);
  }

  :global(:root[data-theme='dark']) .feed__line a:hover {
    color: var(--brand-amber);
  }

  .feed__title {
    color: var(--muted);
  }

  .feed__burst {
    color: var(--muted-2);
    margin-left: 0.35rem;
  }

  .feed__meta {
    font-size: 0.6875rem;
    color: var(--muted-2);
    margin-top: 0.1rem;
  }

  .feed__kind {
    color: var(--muted);
  }
</style>
