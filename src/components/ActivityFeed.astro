---
import type { ActivityEntry } from '../lib/stats';
import { formatRelative } from '../lib/format';

interface Props {
  entries: ActivityEntry[];
  /** Maximum entries shown per column. */
  limit?: number;
}

const { entries, limit = 5 } = Astro.props;

/**
 * Three streams rather than one chronological list: issues, pull requests and
 * commits are what a reader scans for, and side by side they use the width of
 * the page. Releases are deliberately absent — they appear on each project page
 * and as the release chip on every project card.
 */
const COLUMNS: { kind: ActivityEntry['kind']; label: string }[] = [
  { kind: 'issue', label: 'Issues' },
  { kind: 'pull_request', label: 'Pull requests' },
  { kind: 'push', label: 'Commits' },
];

const columns = COLUMNS.map((column) => ({
  ...column,
  items: entries.filter((entry) => entry.kind === column.kind).slice(0, limit),
}));
---

<div class="feed">
  {
    columns.map((column) => (
      <section class="feed__column">
        <h3 class="feed__heading">
          <span class:list={['feed__dot', `feed__dot--${column.kind}`]} aria-hidden="true" />
          {column.label}
        </h3>

        {column.items.length > 0 ? (
          <ul class="feed__list">
            {column.items.map((entry) => (
              <li class="feed__item">
                <p class="feed__line">
                  {entry.url ? (
                    <a href={entry.url} rel="noopener noreferrer" target="_blank">
                      <strong>{entry.repo}</strong>
                    </a>
                  ) : (
                    <strong>{entry.repo}</strong>
                  )}{' '}
                  <span class="feed__title">{entry.title}</span>
                  {entry.burst && entry.burst > 1 && <span class="feed__burst mono">×{entry.burst}</span>}
                </p>
                <p class="feed__meta mono">
                  {entry.actor && <>{entry.actor} &middot; </>}
                  <time datetime={entry.date}>{formatRelative(entry.date)}</time>
                </p>
              </li>
            ))}
          </ul>
        ) : (
          <p class="feed__empty mono">Nothing recent</p>
        )}
      </section>
    ))
  }
</div>

<style>
  .feed {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .feed__column {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    min-inline-size: 0;
  }

  .feed__heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .feed__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .feed__item {
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border);
  }

  .feed__item:last-child {
    border-bottom: 0;
  }

  .feed__dot {
    flex: 0 0 auto;
    inline-size: 7px;
    block-size: 7px;
    border-radius: 999px;
    background: var(--muted-2);
  }

  .feed__dot--issue {
    background: #64748b;
  }

  .feed__dot--pull_request {
    background: #0ea5e9;
  }

  .feed__dot--push {
    background: var(--brand-orange);
  }

  .feed__line {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-soft);
    overflow-wrap: anywhere;
  }

  .feed__line a:hover {
    color: var(--brand-violet-deep);
  }

  :global(:root[data-theme='dark']) .feed__line a:hover {
    color: var(--brand-orange);
  }

  .feed__title {
    color: var(--muted);
  }

  .feed__burst {
    color: var(--muted-2);
    margin-left: 0.35rem;
  }

  .feed__meta {
    font-size: 0.6875rem;
    color: var(--muted-2);
    margin-top: 0.1rem;
  }

  .feed__empty {
    font-size: 0.75rem;
    color: var(--muted-2);
  }

  @media (max-width: 64rem) {
    .feed {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .feed {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
