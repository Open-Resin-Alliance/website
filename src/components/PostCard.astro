---
import type { CollectionEntry } from 'astro:content';
import { getProject } from '../data/projects';
import { formatDate, isoDate } from '../lib/format';

interface Props {
  post: CollectionEntry<'blog'>;
  /** Show the description body text. */
  withDescription?: boolean;
  /** Larger treatment for the pinned post. */
  featured?: boolean;
}

const { post, withDescription = true, featured = false } = Astro.props;
const { title, description, pubDate, category, tags, project } = post.data;
const href = `/blog/${post.id}`;
/** The catalogue's name for the repo, so a plugin reads as a project, not a slug. */
const projectLabel = project ? getProject(project)?.name ?? project : null;

const CATEGORY_LABEL: Record<string, string> = {
  release: 'Release',
  project: 'Project',
  community: 'Community',
  engineering: 'Engineering',
};
---

<article class:list={['card', 'post-card', featured && 'post-card--featured']}>
  <div class="post-card__meta mono">
    <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
    <span class="post-card__sep" aria-hidden="true">/</span>
    <span class="post-card__category">{CATEGORY_LABEL[category] ?? category}</span>
    {projectLabel && (
      <>
        <span class="post-card__sep" aria-hidden="true">/</span>
        <span>{projectLabel}</span>
      </>
    )}
  </div>

  <h3 class:list={['post-card__title', featured && 'post-card__title--featured']}>
    <a href={href}>{title}</a>
  </h3>

  {withDescription && <p class="post-card__description">{description}</p>}

  {
    tags.length > 0 && (
      <div class="post-card__foot mono">
        <span class="post-card__tags">
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </span>
      </div>
    )
  }
</article>

<style>
  /* The surface itself is `.card` (the same glass pane as the project cards);
     this only adds what a post needs inside it. */
  .post-card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.35rem 1.5rem;
  }

  .post-card--featured {
    padding: 1.6rem 1.75rem;
  }

  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted-2);
  }

  .post-card__category {
    color: var(--accent);
  }

  .post-card__sep {
    color: var(--border-strong);
  }

  .post-card__title {
    font-size: 1.1875rem;
    line-height: 1.3;
  }

  .post-card__title--featured {
    font-size: clamp(1.4rem, 1.15rem + 1vw, 1.85rem);
  }

  .post-card__title a {
    transition: color 0.15s var(--ease);
  }

  .post-card__title a:hover {
    color: var(--brand-violet-deep);
  }

  :global(:root[data-theme='dark']) .post-card__title a:hover {
    color: var(--brand-orange);
  }

  .post-card__description {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.65;
    max-width: 68ch;
  }

  .post-card__foot {
    display: flex;
    flex-wrap: wrap;
    /* Baseline, not centre: the tag chips sit on the card's text baseline
       instead of floating against their own padding. */
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    /* Push the footer to the bottom so it lines up across cards of different
       content lengths. */
    margin-top: auto;
    padding-top: 0.75rem;
    font-size: 0.75rem;
    color: var(--muted-2);
  }

  .post-card__tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
</style>
