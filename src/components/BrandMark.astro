---
/**
 * The Open Resin Alliance emblem, cropped from the official logo lockup
 * (`/brand/ora-lockup.webp`, which keeps the ORA wordmark and is used on the
 * About page). This is the real artwork, not a redrawn mark.
 */
interface Props {
  /** Rendered height in pixels; the emblem is very nearly square. */
  size?: number;
  class?: string;
}

const { size = 26, class: className = '' } = Astro.props;
---

<img
  class={`brand-mark ${className}`}
  src="/brand/ora-mark.webp"
  alt=""
  aria-hidden="true"
  style={`--mark-size:${size}px`}
  decoding="async"
  fetchpriority="high"
/>

<style>
  .brand-mark {
    flex: 0 0 auto;
    /* Sized from the prop, never from the 256px source bitmap. */
    block-size: var(--mark-size);
    inline-size: auto;
    transition: transform 0.3s var(--ease);
  }
</style>
