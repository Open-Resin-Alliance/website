---
import type { SpecEntry } from '../lib/specs';
import BaseLayout from '../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { formatDateLong, isoDate } from '../lib/format';
import { specPageUrl } from '../lib/specs';

interface Props {
  entry: SpecEntry;
  /** Every page of this specification, in reading order. */
  pages: SpecEntry[];
}

const { entry, pages } = Astro.props;
const { Content } = await render(entry);
const { title, description, status, shortName, spec, isIndex, sourceRepo, sourcePath, sourceRef, syncedAt } =
  entry.data;

const sourceUrl = `https://github.com/Open-Resin-Alliance/${sourceRepo}/blob/${sourceRef}/${sourcePath}`;
const groupUrl = `/specs/${spec}`;
const position = pages.findIndex((page) => page.id === entry.id);
const previous = position > 0 ? pages[position - 1] : null;
const next = position < pages.length - 1 ? pages[position + 1] : null;

const structuredData = [
  {
    '@type': 'TechArticle',
    headline: isIndex ? title : `${shortName} format specification: ${title}`,
    description,
    url: `https://openresin.org${specPageUrl(entry)}`,
    dateModified: isoDate(syncedAt),
    author: { '@id': 'https://openresin.org/#organization' },
    publisher: { '@id': 'https://openresin.org/#organization' },
    isPartOf: { '@id': 'https://openresin.org/#website' },
    inLanguage: 'en',
  },
];
---

<BaseLayout
  title={isIndex ? title : `${title} - ${shortName} specification`}
  description={description}
  type="article"
  modifiedTime={isoDate(syncedAt)}
  structuredData={structuredData}
>
  <article class="shell spec">
    <nav class="crumbs mono" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/specs">Specs</a>
      <span aria-hidden="true">/</span>
      {
        isIndex ? (
          <span aria-current="page">{shortName}</span>
        ) : (
          <>
            <a href={groupUrl}>{shortName}</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{title}</span>
          </>
        )
      }
    </nav>

    <header class="spec__head">
      <div class="spec__meta mono">
        <span class="spec__status">{status}</span>
        <span class="spec__sep" aria-hidden="true">/</span>
        <span>synced {formatDateLong(syncedAt)}</span>
        <span class="spec__sep" aria-hidden="true">/</span>
        <a href={sourceUrl}>{sourceRepo}@{sourceRef}</a>
        {
          pages.length > 1 && (
            <>
              <span class="spec__sep" aria-hidden="true">/</span>
              <span>{pages.length} parts</span>
            </>
          )
        }
      </div>

      <h1>{title}</h1>
    </header>

    <div class="spec__grid">
      <div class="spec__body prose">
        <Content />
      </div>

      <aside class="spec__side">
        {
          pages.length > 1 && (
            <nav class="spec__parts" aria-label="All parts">
              <h2 class="spec__side-title mono">All parts</h2>
              <ol>
                {pages.map((page) => (
                  <li>
                    <a
                      class="spec__part"
                      href={specPageUrl(page)}
                      aria-current={page.id === entry.id ? 'page' : undefined}
                    >
                      <span class="spec__part-num mono">{String(page.data.order).padStart(2, '0')}</span>
                      <span>{page.data.isIndex ? 'Overview' : page.data.title}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
      </aside>
    </div>

    {
      pages.length > 1 && (
        <nav class="spec__pager mono" aria-label="Previous and next part">
          {previous ? (
            <a class="spec__pager-link" href={specPageUrl(previous)}>
              ← {previous.data.isIndex ? 'Overview' : previous.data.title}
            </a>
          ) : (
            <span />
          )}
          {next ? (
            <a class="spec__pager-link spec__pager-link--next" href={specPageUrl(next)}>
              {next.data.isIndex ? 'Overview' : next.data.title} →
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .spec {
    padding-top: 2.5rem;
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted-2);
    margin-bottom: 1.75rem;
  }

  .crumbs a:hover {
    color: var(--ink);
  }

  .crumbs span[aria-current] {
    color: var(--muted);
  }

  .spec__head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    max-width: var(--measure);
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .spec__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted-2);
  }

  .spec__status {
    color: var(--accent);
  }

  .spec__sep {
    color: var(--border-strong);
  }

  .spec__head h1 {
    font-size: clamp(1.9rem, 1.4rem + 2.2vw, 2.8rem);
  }

  /* Explicit tracks at both sizes, like the post grid: an implicit `auto` column
     sizes to the widest content, and a specification is mostly wide tables. The
     sidebar is wide enough for a part title to read as a label rather than a
     wrapped fragment. */
  .spec__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    gap: 3rem;
    align-items: start;
    /* The head's own border is the separator, so the grid does not need the
       generous lead-in the post grid uses. */
    padding-top: 1.5rem;
  }

  /* The parts list is the only navigation, so it gets the whole rail: at a normal
     window height all twenty parts are visible without scrolling, and the rail
     only scrolls when the window is too short for them.

     The inset lives in the container's padding rather than in a negative margin on
     the rows: `overflow-y: auto` makes `overflow-x` compute to `auto` as well, so a
     row that hangs outside the content box puts a horizontal scrollbar under the
     list. Padding is inside the scroll box, so nothing hangs out. */
  .spec__side {
    position: sticky;
    top: 5.5rem;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    padding-inline: 0.5rem 0;
    font-size: 0.875rem;
  }

  .spec__side-title {
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted-2);
    margin-bottom: 0.6rem;
  }

  .spec__parts ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .spec__part {
    display: grid;
    grid-template-columns: 1.7rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.15rem;
    /* Left padding is zero so the number lines up with "All parts"; the right
       padding stops the row highlight short of nothing - the row runs to the
       rail's edge because the container has no right padding. */
    padding: 0.4rem 0.5rem 0.4rem 0;
    border-radius: var(--radius-sm);
    line-height: 1.4;
    color: var(--muted);
    overflow-wrap: anywhere;
    transition:
      color 0.15s var(--ease),
      background-color 0.15s var(--ease);
  }

  .spec__part-num {
    font-size: 0.75rem;
    color: var(--muted-2);
  }

  .spec__part:hover {
    color: var(--ink);
    background-color: var(--bg-inset);
  }

  .spec__part[aria-current='page'] {
    color: var(--ink);
    background-color: var(--bg-inset);
    font-weight: 500;
  }

  .spec__part[aria-current='page'] .spec__part-num {
    color: var(--accent);
  }

  .spec__pager {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.8125rem;
  }

  .spec__pager-link {
    color: var(--muted);
    transition: color 0.15s var(--ease);
  }

  .spec__pager-link:hover {
    color: var(--ink);
  }

  @media (max-width: 960px) {
    .spec__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .spec__side {
      position: static;
      /* Twenty parts before the article is a lot of scrolling on a phone, so the
         navigation scrolls in place instead. */
      max-height: 15rem;
      order: -1;
      border-bottom: 1px solid var(--border);
      padding-bottom: 1.5rem;
    }
  }
</style>
