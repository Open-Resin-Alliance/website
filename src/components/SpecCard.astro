---
import type { SpecEntry } from '../lib/specs';
import { formatDate } from '../lib/format';
import { specPageUrl } from '../lib/specs';

interface Props {
  /** The specification's first page: the card describes the whole of it. */
  entry: SpecEntry;
  pageCount: number;
}

const { entry, pageCount } = Astro.props;
const { title, description, status, syncedAt, sourceRepo, sourceRef } = entry.data;
---

<article class="card spec-card">
  <div class="spec-card__meta mono">
    <span class="spec-card__status">{status}</span>
    <span class="spec-card__sep" aria-hidden="true">/</span>
    <span>{pageCount === 1 ? 'single page' : `${pageCount} parts`}</span>
    <span class="spec-card__sep" aria-hidden="true">/</span>
    <span>synced {formatDate(syncedAt)}</span>
  </div>

  <h3 class="spec-card__title">
    <a href={specPageUrl(entry)}>{title}</a>
  </h3>

  <p class="spec-card__description">{description}</p>

  <div class="spec-card__foot mono">{sourceRepo}@{sourceRef}</div>
</article>

<style>
  /* The surface itself is `.card`, the same glass pane as the post and project
     cards; this only adds what a specification needs inside it. */
  .spec-card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.35rem 1.5rem;
  }

  .spec-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted-2);
  }

  .spec-card__status {
    color: var(--accent);
  }

  .spec-card__sep {
    color: var(--border-strong);
  }

  .spec-card__title {
    font-size: 1.1875rem;
    line-height: 1.3;
  }

  .spec-card__title a {
    transition: color 0.15s var(--ease);
  }

  .spec-card__title a:hover {
    color: var(--brand-violet-deep);
  }

  :global(:root[data-theme='dark']) .spec-card__title a:hover {
    color: var(--brand-orange);
  }

  .spec-card__description {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.65;
    max-width: var(--measure);
  }

  .spec-card__foot {
    /* Pushed to the bottom so it lines up across cards of different lengths. */
    margin-top: auto;
    padding-top: 0.75rem;
    font-size: 0.75rem;
    color: var(--muted-2);
  }
</style>
