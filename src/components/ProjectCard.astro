---
import { projectPath, type Project } from '../data/projects';
import { repoStats } from '../lib/stats';
import { formatCompact } from '../lib/format';
import { LANGUAGE_COLORS, STARS_COLOR } from '../lib/tag-colors';

interface Props {
  project: Project;
  /** Show the longer summary instead of the one-line blurb. */
  detailed?: boolean;
}

const { project, detailed = false } = Astro.props;
const live = repoStats(project.repo);
const headline = live?.latestStableRelease ?? live?.latestRelease ?? null;
const blurb = live?.description ?? (detailed ? project.summary : project.blurb);
const languages = live?.language ? [live.language, ...(project.additionalLanguages ?? [])] : [];
const primaryLangColor = languages[0] ? LANGUAGE_COLORS[languages[0]] : undefined;
---

<a class="card project-card" href={projectPath(project)} data-repo={project.repo}>
  <div class="project-card__head">
    <h3 class="project-card__name">{project.name}</h3>
    {headline && <span class="project-card__version mono">{headline.tag}</span>}
  </div>

  <p class="project-card__blurb">{blurb}</p>

  <div class="project-card__foot mono">
    {
      languages.length > 0 && (
        <span class="project-card__lang">
          {primaryLangColor && <span class="project-card__dot" style={`background:${primaryLangColor}`} aria-hidden="true" />}
          <span>{languages.join(' · ')}</span>
        </span>
      )
    }
    {
      project.license && (
        <>
          {languages.length > 0 && <span class="project-card__sep" aria-hidden="true">/</span>}
          <span>{project.license}</span>
        </>
      )
    }
    {
      live && live.stars > 0 && (
        <>
          {(languages.length > 0 || project.license) && <span class="project-card__sep" aria-hidden="true">/</span>}
          <span class="project-card__stars">
            <span style={`color:${STARS_COLOR}`} aria-hidden="true">★</span>
            <span data-live="stars:compact">{formatCompact(live.stars)}</span>
          </span>
        </>
      )
    }
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.4rem 1.55rem;
  }

  .project-card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .project-card__name {
    font-size: 1.125rem;
    color: var(--ink);
    transition: color 0.15s var(--ease);
  }

  .project-card:hover .project-card__name {
    color: var(--brand-violet-deep);
  }

  :global(:root[data-theme='dark']) .project-card:hover .project-card__name {
    color: var(--brand-orange);
  }

  .project-card__version {
    font-size: 0.75rem;
    color: var(--muted-2);
    white-space: nowrap;
  }

  .project-card__blurb {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    flex: 1 1 auto;
  }

  .project-card__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    margin-top: 0.35rem;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .project-card__lang {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .project-card__dot {
    inline-size: 7px;
    block-size: 7px;
    border-radius: 999px;
    flex-shrink: 0;
  }

  .project-card__sep {
    color: var(--border-strong);
  }

  .project-card__stars {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-variant-numeric: tabular-nums;
  }
</style>
