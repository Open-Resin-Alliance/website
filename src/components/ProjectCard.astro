---
import { projectPath, type Project } from '../data/projects';
import { repoStats } from '../lib/stats';
import { formatCompact } from '../lib/format';
import { CRATE_COLOR, ISSUES_COLOR, STARS_COLOR, licenseColor } from '../lib/tag-colors';
import LanguageTags from './LanguageTags.astro';
import ReleaseChip from './ReleaseChip.astro';

interface Props {
  project: Project;
  /** Show the longer summary instead of the one-line blurb. */
  detailed?: boolean;
}

const { project, detailed = false } = Astro.props;
const live = repoStats(project.repo);
// Prefer the newest stable release; fall back to the newest build of any kind
// only for projects that have never cut one, so the chip is never empty-handed.
const headline = live?.latestStableRelease ?? live?.latestRelease ?? null;
/* The card's text is the repository's own description when it has one: this page already
   shows the repositories' numbers, and a description written on GitHub is the project's
   account of itself. The catalogue is the fallback - for a repository that carries no
   description, and for the longer summary, which no repository holds. */
const blurb = live?.description ?? (detailed ? project.summary : project.blurb);
---

{/* The whole card is a single link; the release chip inside it must not be one. */}
<a class="card project-card" href={projectPath(project)} data-repo={project.repo}>
  <div class="project-card__head">
    <h3 class="project-card__name">{project.name}</h3>
    {
      live?.language && (
        <span class="project-card__languages">
          <LanguageTags languages={[live.language, ...(project.additionalLanguages ?? [])]} />
        </span>
      )
    }
  </div>

  <p class="project-card__blurb">{blurb}</p>

  <div class="project-card__meta">
    {
      project.crate && (
        <span class="tag mono tag--tinted" style={`--tag:${CRATE_COLOR}`}>
          crate {project.crate}
        </span>
      )
    }
    {
      project.license && (
        <span
          class="tag mono tag--tinted"
          style={licenseColor(project.license) ? `--tag:${licenseColor(project.license)}` : undefined}
        >
          {project.license}
        </span>
      )
    }
    {
      live && live.stars > 0 && (
        <span class="tag mono tag--tinted" style={`--tag:${STARS_COLOR}`}>
          ★ <span data-live="stars:compact">{formatCompact(live.stars)}</span>
        </span>
      )
    }
    {
      live && live.openIssues > 0 && (
        <span class="tag mono tag--tinted" style={`--tag:${ISSUES_COLOR}`}>
          <span>{formatCompact(live.openIssues)}</span> issues
        </span>
      )
    }
  </div>

  {
    headline && (
      <div class="project-card__release">
        <ReleaseChip
          release={headline}
          label={live?.latestStableRelease ? 'Latest release' : 'Latest build'}
          link={false}
        />
      </div>
    )
  }
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.35rem 1.4rem 1.4rem;
  }

  .project-card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  /* Keep the language chips together at the right edge; the head row spreads its
     children apart, which would pull a second chip away from the first. */
  .project-card__languages {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.4rem;
  }

  .project-card__name {
    font-size: 1.0625rem;
  }

  .project-card__blurb {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    flex: 1 1 auto;
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .project-card__release {
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }
</style>
