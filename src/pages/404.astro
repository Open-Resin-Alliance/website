---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LINKS } from '../data/site';
import { FEATURED_PROJECTS, projectSlug } from '../data/projects';
---

<BaseLayout
  title="Page not found"
  description="That page does not exist. Try the projects, the blog, or the organisation overview."
  noindex
>
  <section class="shell not-found">
    <p class="eyebrow">Error 404</p>
    <h1>That page does not exist</h1>
    <p class="lede">
      The link may be out of date, or the page may have moved. Here are the places people usually want.
    </p>

    <div class="not-found__links">
      <a class="link-card" href="/projects">
        <strong>Projects</strong>
        <span class="muted">The slicer, the printer UI, the backend and the plugins</span>
      </a>
      <a class="link-card" href="/blog">
        <strong>Blog</strong>
        <span class="muted">Release notes and project write-ups</span>
      </a>
      <a class="link-card" href={LINKS.github} rel="noopener noreferrer" target="_blank">
        <strong>GitHub</strong>
        <span class="muted">Source, issues and releases</span>
      </a>
    </div>

    <ul class="not-found__list">
      {
        FEATURED_PROJECTS.map((project) => (
          <li>
            <a href={`/projects/${projectSlug(project)}`}>{project.name}</a>
            <span class="muted">{project.blurb}</span>
          </li>
        ))
      }
    </ul>

    <div class="btn-row">
      <a class="btn btn--primary" href="/">Back to the home page</a>
      <a class="btn btn--ghost" href={LINKS.discord} rel="noopener noreferrer" target="_blank">Ask on Discord</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: flex-start;
    padding: clamp(3rem, 2rem + 6vw, 6rem) 0 4rem;
    max-width: 820px;
  }

  .not-found .lede {
    max-width: 62ch;
  }

  .not-found__links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 0.85rem;
    inline-size: 100%;
    margin-top: 0.5rem;
  }

  .link-card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1rem 1.1rem;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.9375rem;
    transition: border-color 0.18s var(--ease), transform 0.18s var(--ease);
  }

  .link-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }

  .link-card span {
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .not-found__list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    inline-size: 100%;
  }

  .not-found__list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.85rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--border);
    font-size: 0.9375rem;
  }

  .not-found__list a {
    font-weight: 550;
    letter-spacing: -0.012em;
  }

  .not-found__list a:hover {
    color: var(--brand-violet-deep);
  }

  :global(:root[data-theme='dark']) .not-found__list a:hover {
    color: var(--brand-orange);
  }

  .not-found__list span {
    font-size: 0.8125rem;
  }
</style>
