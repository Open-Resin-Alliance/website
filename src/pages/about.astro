---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LINKS, SITE } from '../data/site';
import { FEATURED_PROJECTS, PROJECTS } from '../data/projects';
import { stats } from '../lib/stats';
import { formatDate, formatCompact, formatNumber } from '../lib/format';

const principles = [
  {
    title: 'Open source collaboration',
    body: 'We believe that by sharing knowledge and resources, we can accelerate innovation and make high-quality 3D printing accessible to everyone. Every project we ship is public, and every design decision is open to review.',
  },
  {
    title: 'Hardware independence',
    body: 'Proprietary file formats and closed firmware limit what a resin printer can do. We build tooling that keeps the hardware honest and the data readable, including clean-room reverse engineering where interoperability requires it.',
  },
  {
    title: 'Reference designs, not just software',
    body: 'Alongside the slicer, the printer frontend and the printer backend, we publish the reference designs that prove the stack works on real machines.',
  },
];

const languages = Object.entries(stats.totals.languages).sort((a, b) => b[1] - a[1]);
const established = `We are a group of hobbyists and developers from around the globe, joined in our dedication to advancing the field of resin-based 3D printing through open source collaboration. The alliance was established on ${formatDate(SITE.founded)}.`;

/** Reads "A, B, C and D" rather than a comma list. */
const listFormat = new Intl.ListFormat('en-GB', { style: 'long', type: 'conjunction' });

/** Names only - the sentence around them stays in the template. */
const coreProjects = listFormat.format(FEATURED_PROJECTS.map((project) => project.name));

/** Projects whose repository was created before the alliance existed. */
const predating = PROJECTS.filter((project) => {
  const createdAt = stats.repos[project.repo]?.createdAt;
  return Boolean(createdAt && Date.parse(createdAt) < Date.parse(SITE.founded));
});
---

<BaseLayout
  title="About"
  description={`${SITE.name} is a group of hobbyists and developers from around the globe advancing resin-based 3D printing through open source collaboration. Founded ${formatDate(SITE.founded)}.`}
>
  <section class="shell page-head">
    <p class="eyebrow">About</p>
    <h1>A collective for open-source resin printing</h1>
    <p class="lede">{established}</p>
  </section>

  <section class="shell section">
    <div class="panel">
      <div class="panel__block">
        <h2>What we do</h2>
        <p>
          All of our projects, primarily software and reference designs for open-source resin 3D printing, are hosted
          on GitHub: {coreProjects}, plus the plugins and tooling that support them.
        </p>
        {
          predating.length > 0 && (
            <p>
              Some of these projects grew elsewhere before moving to the alliance.{' '}
              {listFormat.format(predating.map((project) => project.name))} predate the organisation itself and were
              built for the Apollo control board series and the Prometheus MSLA printer.
            </p>
          )
        }
        <div class="btn-row">
          <a class="btn btn--primary btn--sm" href="/projects">Browse projects</a>
          <a class="btn btn--ghost btn--sm" href={LINKS.githubRepos} rel="noopener noreferrer" target="_blank">
            <span data-live="repos">{stats.totals.repos}</span> repositories on GitHub
          </a>
        </div>
      </div>
    </div>

    <dl class="stats">
      <div class="stats__item">
        <dt class="stats__value" data-live="repos">{formatNumber(stats.totals.repos)}</dt>
        <dd class="stats__label">
          public repositories
          <span class="mono">on GitHub</span>
        </dd>
      </div>
      <div class="stats__item">
        <dt class="stats__value" data-live="stars:compact">{formatCompact(stats.totals.stars)}</dt>
        <dd class="stats__label">
          stars
          <span class="mono">across the org</span>
        </dd>
      </div>
      <div class="stats__item">
        <dt class="stats__value">{formatNumber(stats.totals.contributors)}</dt>
        <dd class="stats__label">
          contributors
          <span class="mono">flagship projects</span>
        </dd>
      </div>
      <div class="stats__item">
        <dt class="stats__value" data-live="active-repos">{stats.totals.activeRepos}</dt>
        <dd class="stats__label">
          active repos
          <span class="mono">pushed in 90 days</span>
        </dd>
      </div>
    </dl>
    <p class="muted" data-live-status>Snapshot &middot; {formatDate(stats.generatedAt)}</p>
  </section>

  <section class="shell section">
    <div class="section-head">
      <div class="section-head__text">
        <h2>What we believe</h2>
      </div>
    </div>
    <div class="grid grid--3">
      {
        principles.map((principle) => (
          <div class="card principle">
            <h3>{principle.title}</h3>
            <p>{principle.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="shell section">
    <div class="split">
      <div>
        <h2>Where the work happens</h2>
        <p class="muted">
          Development is public. Issues, pull requests, releases and nightly builds are all visible on GitHub, and
          day-to-day discussion happens on Discord. There is no private roadmap: if we are working on something, you
          can watch it happen or join in.
        </p>
        <ul class="facts-list">
          <li>
            <span class="mono">Releases</span>
            <span>{stats.totals.releases} projects with a tagged release, refreshed continuously</span>
          </li>
          <li>
            <span class="mono">Active repos</span>
            <span><span data-live="active-repos">{stats.totals.activeRepos}</span> pushed to in the last 90 days</span>
          </li>
          <li>
            <span class="mono">Open issues</span>
            <span><span>{formatNumber(stats.totals.openIssues)}</span> across the organisation</span>
          </li>
          <li>
            <span class="mono">Languages</span>
            <span>{languages.map(([language, count]) => `${language} (${count})`).join(', ')}</span>
          </li>
        </ul>
      </div>

      <div class="join">
        <h2>Joining in</h2>
        <p class="muted">
          There is no formal membership process. Pick a repository, read its contributing section, and open a pull
          request - or bring a question, a bug report or a printer to the Discord.
        </p>
        <ul class="join__list">
          <li>
            <a href={LINKS.discord} rel="noopener noreferrer" target="_blank">
              <strong>Discord</strong>
              <span class="muted">Talk to the people building this</span>
            </a>
          </li>
          <li>
            <a href={LINKS.githubRepos} rel="noopener noreferrer" target="_blank">
              <strong>GitHub</strong>
              <span class="muted">Issues, pull requests and source</span>
            </a>
          </li>
          <li>
            <a href={LINKS.email}>
              <strong>Email</strong>
              <span class="muted">{SITE.email}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    padding-block: clamp(2.5rem, 2rem + 3vw, 4rem) 0;
  }

  .page-head .lede {
    max-width: 68ch;
  }


  .section {
    padding-block: 3rem 0;
  }

  .panel {
    padding: 2rem 2.25rem;
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-shadow);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
  }

  .panel__block {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    align-items: flex-start;
  }

  .panel__block h2 {
    font-size: 1.4rem;
  }

  .panel__block p {
    color: var(--muted);
  }

  /* Organisation figures: the same glass cells that used to sit in the hero. */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding: 0;
  }

  /* Independent cells, not one sealed grid: a shared container background sits
     behind the translucent fill and hides the wash. */
  .stats__item {
    padding: 1.4rem 1.5rem;
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    box-shadow: var(--glass-shadow);
  }

  .stats__value {
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem);
    font-weight: 620;
    letter-spacing: -0.035em;
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
  }

  .stats__label {
    display: flex;
    flex-direction: column;
    margin: 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .stats__label .mono {
    font-size: 0.625rem;
    color: var(--muted-2);
  }

  .principle {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.4rem 1.5rem;
  }

  .principle h3 {
    font-size: 1.0625rem;
  }

  .principle p {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
  }

  .split h2 {
    font-size: 1.4rem;
    margin-bottom: 0.85rem;
  }

  .split p {
    max-width: 62ch;
  }

  .facts-list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .facts-list li {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding: 0.65rem 0;
    border-top: 1px solid var(--border);
    font-size: 0.9375rem;
  }

  .facts-list .mono {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.625rem;
    color: var(--muted-2);
    padding-top: 0.2rem;
  }

  .join__list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .join__list a {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.9rem 1rem;
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-shadow);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    font-size: 0.9375rem;
    transition: border-color 0.18s var(--ease), transform 0.18s var(--ease);
  }

  .join__list a:hover {
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }

  .join__list span {
    font-size: 0.8125rem;
  }

  @media (max-width: 64rem) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 960px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    .panel {
      padding: 1.5rem 1.25rem;
    }

  }

  @media (max-width: 34rem) {
    .stats {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
