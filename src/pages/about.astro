---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
import { stats } from '../lib/stats';
import { formatDate, formatCompact, formatNumber } from '../lib/format';

const principles = [
  {
    title: 'Open source collaboration',
    body: 'We believe that by sharing knowledge and resources, we can accelerate innovation and make high-quality 3D printing accessible to everyone. Every project we ship is public, and every design decision is open to review.',
  },
  {
    title: 'Hardware independence',
    body: 'Proprietary file formats and closed firmware limit what a resin printer can do. We build tooling that keeps the hardware honest and the data readable, including clean-room reverse engineering where interoperability requires it.',
  },
  {
    title: 'Reference designs, not just software',
    body: 'Alongside the slicer, the printer frontend and the printer backend, we publish the reference designs that prove the stack works on real machines.',
  },
];

const languages = Object.entries(stats.totals.languages).sort((a, b) => b[1] - a[1]);
const established = `We are a group of hobbyists and developers from around the globe, joined in our dedication to advancing the field of resin-based 3D printing through open source collaboration. The alliance was established on ${formatDate(SITE.founded)}.`;

---

<BaseLayout
  title="About"
  description={`${SITE.name} is a group of hobbyists and developers from around the globe advancing resin-based 3D printing through open source collaboration. Founded ${formatDate(SITE.founded)}.`}
>
  <section class="shell page-head">
    <p class="eyebrow">About</p>
    <h1>A collective for open-source resin printing</h1>
    <p class="lede">{established}</p>
  </section>

  <section class="shell section">
    <dl class="stats">
      <div class="stats__item">
        <dt class="stats__value" data-live="repos">{formatNumber(stats.totals.repos)}</dt>
        <dd class="stats__label">
          public repositories
          <span class="mono">on GitHub</span>
        </dd>
      </div>
      <div class="stats__item">
        <dt class="stats__value" data-live="stars:compact">{formatCompact(stats.totals.stars)}</dt>
        <dd class="stats__label">
          stars
          <span class="mono">across the org</span>
        </dd>
      </div>
      <div class="stats__item">
        <dt class="stats__value">{formatNumber(stats.totals.contributors)}</dt>
        <dd class="stats__label">
          contributors
          <span class="mono">flagship projects</span>
        </dd>
      </div>
      <div class="stats__item">
        <dt class="stats__value" data-live="active-repos">{stats.totals.activeRepos}</dt>
        <dd class="stats__label">
          active repos
          <span class="mono">pushed in 90 days</span>
        </dd>
      </div>
    </dl>
  </section>

  <section class="shell section">
    <ul class="grid grid--3 principles" aria-label="What we believe">
      {
        principles.map((principle) => (
          <li class="card principle">
            <h2>{principle.title}</h2>
            <p>{principle.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="shell section">
    <div class="split">
      <div>
        <h2>Where the work happens</h2>
        <p class="muted">
          Development is public. Issues, pull requests, releases and nightly builds are all visible on GitHub, and
          day-to-day discussion happens on Discord. There is no private roadmap: if we are working on something, you
          can watch it happen or join in.
        </p>
        <ul class="facts-list">
          <li>
            <span class="mono">Releases</span>
            <span>{stats.totals.releases} projects with a tagged release</span>
          </li>
          <li>
            <span class="mono">Active repos</span>
            <span><span data-live="active-repos">{stats.totals.activeRepos}</span> pushed to in the last 90 days</span>
          </li>
          <li>
            <span class="mono">Open issues</span>
            <span><span>{formatNumber(stats.totals.openIssues)}</span> across the organisation</span>
          </li>
          <li>
            <span class="mono">Languages</span>
            <span>{languages.map(([language, count]) => `${language} (${count})`).join(', ')}</span>
          </li>
        </ul>
      </div>

      <div>
        <h2>What we mean by open source</h2>
        <p class="muted">One definition for the code, one for the designs.</p>
        <ul class="facts-list">
          <li>
            <span class="mono">Software</span>
            <ul class="bullets">
              <li>
                Every repository ships under a licence the OSI has approved: MIT, Apache-2.0,
                GPL-3.0 and AGPL-3.0.
              </li>
              <li>
                Open source here means the{' '}
                <a href="https://opensource.org/osd" rel="noopener noreferrer" target="_blank">
                  Open Source Definition</a
                >: run it, study it, modify it, redistribute it.
              </li>
            </ul>
          </li>
          <li>
            <span class="mono">Hardware</span>
            <ul class="bullets">
              <li>Designs go out with the files to build and modify them, and the documentation to understand them.</li>
              <li>
                Held to the{' '}
                <a href="https://www.oshwa.org/definition/" rel="noopener noreferrer" target="_blank">
                  Open Source Hardware definition</a
                >{' '}
                from OSHWA - including making and selling your own.
              </li>
            </ul>
          </li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    padding-block: clamp(2.5rem, 2rem + 3vw, 4rem) 0;
  }

  .page-head .lede {
    max-width: var(--measure);
  }


  .section {
    padding-block: 3rem 0;
  }

  /* Organisation figures: the same glass cells that used to sit in the hero. */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
  }

  /* Independent cells, not one sealed grid: a shared container background sits
     behind the translucent fill and hides the wash. */
  .stats__item {
    padding: 1.4rem 1.5rem;
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    box-shadow: var(--glass-shadow);
  }

  .stats__value {
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem);
    font-weight: 620;
    letter-spacing: -0.035em;
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
  }

  .stats__label {
    display: flex;
    flex-direction: column;
    margin: 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .stats__label .mono {
    font-size: 0.625rem;
    color: var(--muted-2);
  }

  /* A list of beliefs rather than a section: no visible heading, and the three
     names are the h2s the section used to carry. */
  .principles {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .principle {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.4rem 1.5rem;
  }

  .principle h2 {
    font-size: 1.0625rem;
  }

  .principle p {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
  }

  .split h2 {
    font-size: 1.4rem;
    margin-bottom: 0.85rem;
  }

  .split p {
    max-width: var(--measure);
  }

  .facts-list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .facts-list li {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding: 0.65rem 0;
    border-top: 1px solid var(--border);
    font-size: 0.9375rem;
  }

  /* A fact whose value is a list of short points rather than a line. */
  .bullets {
    list-style: disc;
    margin: 0;
    padding-inline-start: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .bullets li {
    display: list-item;
    padding: 0;
    border-top: 0;
  }

  .facts-list .mono {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.625rem;
    color: var(--muted-2);
    padding-top: 0.2rem;
  }

  @media (max-width: 64rem) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 960px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

  }

  @media (max-width: 34rem) {
    .stats {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
