---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReleaseChip from '../../components/ReleaseChip.astro';
import PostCard from '../../components/PostCard.astro';
import { PROJECTS, projectSlug, repoUrl } from '../../data/projects';
import { repoStats } from '../../lib/stats';
import { formatCompact, formatDate, formatRelative } from '../../lib/format';

export function getStaticPaths() {
  return PROJECTS.map((project) => ({
    params: { repo: projectSlug(project) },
    props: { project },
  }));
}

const { project } = Astro.props;
const live = repoStats(project.repo);
const repository = repoUrl(project.repo);

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.project === project.repo)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const facts = [
  { label: 'Language', value: live?.language ?? project.language },
  { label: 'Licence', value: project.license ?? 'Not declared' },
  { label: 'Stars', value: live ? formatCompact(live.stars) : '—' },
  { label: 'Forks', value: live ? formatCompact(live.forks) : '—' },
  { label: 'Open issues', value: live ? formatCompact(live.openIssues) : '—' },
  { label: 'Created', value: live ? formatDate(live.createdAt) : '—' },
  { label: 'Last push', value: live ? formatDate(live.pushedAt) : '—' },
  { label: 'Default branch', value: live?.defaultBranch ?? '—' },
];

const structuredData = [
  {
    '@type': 'SoftwareSourceCode',
    name: project.name,
    description: project.summary,
    codeRepository: repository,
    programmingLanguage: live?.language ?? project.language,
    license: project.license ? `https://spdx.org/licenses/${project.license}.html` : undefined,
    isPartOf: { '@id': 'https://openresin.org/#organization' },
    ...(project.website ? { sameAs: project.website } : {}),
  },
];
---

<BaseLayout
  title={project.name}
  description={`${project.blurb} ${live ? `${formatCompact(live.stars)} stars, ${formatCompact(live.openIssues)} open issues.` : ''}`.trim()}
  type="article"
  structuredData={structuredData}
>
  <article class="shell page">
    <nav class="crumbs mono" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/projects">Projects</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{project.name}</span>
    </nav>

    <header class="page__head">
      <div class="page__title">
        <h1>{project.name}</h1>
        <p class="lede">{project.blurb}</p>
      </div>
      <div class="page__actions">
        <a class="btn btn--primary" href={repository} rel="noopener noreferrer" target="_blank">View on GitHub</a>
        {
          project.website && (
            <a class="btn btn--ghost" href={project.website} rel="noopener noreferrer" target="_blank">
              Project website
            </a>
          )
        }
      </div>
    </header>

    <div class="page__badges">
      <span class="tag mono">{project.language}</span>
      {project.license && <span class="tag mono">{project.license}</span>}
      {live?.archived && <span class="tag mono">archived</span>}
      {
        live?.pushedAt && (
          <span class="tag mono">
            <span class:list={['dot', live.pushedAt && Date.parse(live.pushedAt) > Date.now() - 90 * 86_400_000 ? 'dot--live' : 'dot--wip']} />
            active {formatRelative(live.pushedAt)}
          </span>
        )
      }
    </div>

    <div class="page__grid">
      <div class="page__body">
        {
          project.image && (
            <figure class="shot">
              <img src={project.image} alt={`${project.name} running on a desktop`} loading="lazy" decoding="async" />
              <figcaption class="mono">{project.name} running on a desktop</figcaption>
            </figure>
          )
        }

        <p class="page__summary">{project.summary}</p>

        {
          project.capabilities.length > 0 && (
            <section class="block">
              <h2>What it does</h2>
              <ul class="bullets">
                {project.capabilities.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </section>
          )
        }

        {
          live && live.recentReleases.length > 0 && (
            <section class="block">
              <h2>Recent releases</h2>
              <ul class="releases">
                {live.recentReleases.map((release) => (
                  <li>
                    <a href={release.url} rel="noopener noreferrer" target="_blank">
                      <span class="releases__name">{release.name}</span>
                      <span class="mono releases__tag">{release.tag}</span>
                    </a>
                    <span class="mono releases__meta">
                      {formatDate(release.publishedAt)}
                      {release.prerelease ? ' · pre-release' : ''}
                    </span>
                  </li>
                ))}
              </ul>
              {live.latestStableRelease && (
                <ReleaseChip release={live.latestStableRelease} label="Latest stable" />
              )}
            </section>
          )
        }

        {
          posts.length > 0 && (
            <section class="block">
              <h2>Related posts</h2>
              <div class="related">
                {posts.map((post) => (
                  <PostCard post={post} />
                ))}
              </div>
            </section>
          )
        }
      </div>

      <aside class="page__aside">
        <dl class="facts">
          {
            facts.map((fact) => (
              <div class="facts__row">
                <dt class="mono">{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>

        {
          live?.topics && live.topics.length > 0 && (
            <div class="topics">
              <h2 class="topics__title mono">Topics</h2>
              <p class="topics__list">
                {live.topics.map((topic) => (
                  <span class="tag mono">{topic}</span>
                ))}
              </p>
            </div>
          )
        }

        <div class="aside-links">
          <a href={`${repository}/issues`} rel="noopener noreferrer" target="_blank">Issues &amp; bug reports</a>
          <a href={`${repository}/pulls`} rel="noopener noreferrer" target="_blank">Pull requests</a>
          <a href={`${repository}/releases`} rel="noopener noreferrer" target="_blank">All releases</a>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .page {
    padding-top: 2.5rem;
    max-width: var(--shell);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted-2);
    margin-bottom: 1.75rem;
  }

  .crumbs a:hover {
    color: var(--ink);
  }

  .crumbs span[aria-current] {
    color: var(--muted);
  }

  .page__head {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
    align-items: flex-end;
    justify-content: space-between;
  }

  .page__title {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 60ch;
  }

  .page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .page__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.5rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--border);
  }

  .dot {
    margin-right: 0.1rem;
  }

  .page__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: 3.5rem;
    padding: 2.5rem 0 0;
    align-items: start;
  }

  .page__body {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    min-width: 0;
  }

  .page__summary {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--ink-soft);
    max-width: 68ch;
  }

  .shot {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .shot img {
    inline-size: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-inset);
  }

  .shot figcaption {
    font-size: 0.6875rem;
    color: var(--muted-2);
  }

  .block h2 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }

  .bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    max-width: 68ch;
  }

  .bullets li {
    position: relative;
    padding-left: 1.15rem;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6rem;
    inline-size: 5px;
    block-size: 5px;
    border-radius: 999px;
    background: var(--brand-pink);
  }

  .releases {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .releases li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border);
  }

  .releases li:last-child {
    border-bottom: 0;
  }

  .releases a {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    min-width: 0;
  }

  .releases__name {
    font-size: 0.9375rem;
    font-weight: 550;
    letter-spacing: -0.012em;
  }

  .releases a:hover .releases__name {
    color: var(--brand-violet-deep);
  }

  :global(:root[data-theme='dark']) .releases a:hover .releases__name {
    color: var(--brand-orange);
  }

  .releases__tag {
    font-size: 0.6875rem;
    color: var(--muted-2);
    overflow-wrap: anywhere;
  }

  .releases__meta {
    font-size: 0.6875rem;
    color: var(--muted-2);
    white-space: nowrap;
  }

  .related {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .facts {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-raised);
  }

  .facts__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.875rem;
  }

  .facts__row:last-child {
    border-bottom: 0;
  }

  .facts__row dt {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-2);
  }

  .facts__row dd {
    margin: 0;
    text-align: right;
    overflow-wrap: anywhere;
  }

  .topics {
    margin-top: 1.5rem;
  }

  .topics__title {
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted-2);
    margin-bottom: 0.6rem;
  }

  .topics__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .aside-links {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.9375rem;
  }

  .aside-links a {
    color: var(--muted);
  }

  .aside-links a:hover {
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .page__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
  }
</style>
