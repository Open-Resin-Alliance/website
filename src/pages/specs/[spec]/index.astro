---
import { getCollection } from 'astro:content';
import SpecDocument from '../../../components/SpecDocument.astro';
import { groupSpecs } from '../../../lib/specs';

/* One page per specification, not per part: a part is a section of the document
   and its own URL only forwards here. */
export async function getStaticPaths() {
  const groups = groupSpecs(await getCollection('specs'));
  return [...groups.values()].map((pages) => ({
    params: { spec: pages[0].data.spec },
    props: { pages },
  }));
}

const { pages } = Astro.props;
---

<SpecDocument pages={pages} />
