---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import StatsTable from '../components/StatsTable.astro';

import DiscordIcon from '../components/DiscordIcon.astro';
import { getCollection } from 'astro:content';
import { FEATURED_PROJECTS, PLUGIN_PROJECTS, projectSlug } from '../data/projects';
import { LINKS, SITE } from '../data/site';
import { stats } from '../lib/stats';
import { collectiveUrl, supporters } from '../lib/supporters';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPosts = posts.slice(0, 3);

---

<BaseLayout description={SITE.description}>
  <section class="hero" data-hero>
    <div class="shell">
      <div class="hero__copy">
        <h1>
          Advancing Open Source<br />
          <span class="text-brand">Resin 3D Printing</span>
        </h1>
        <p class="lede">
          We are a group of hobbyists and developers from around the globe, joined in our dedication to advancing
          the field of resin-based 3D printing through open source collaboration.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/projects">Explore our projects</a>
          <a class="btn btn--discord" href={LINKS.discord} rel="noopener noreferrer" target="_blank">
            <DiscordIcon size={16} />Join the Discord
          </a>
        </div>
      </div>
    </div>

    {/* Says what the page does next rather than being content of it: the hero
        holds the first screen, and scrolling is how the rest arrives. */}
    <p class="hero__hint mono" aria-hidden="true">
      <span>Scroll</span>
      <svg class="hero__chevron" viewBox="0 0 24 15" focusable="false">
        <path d="M2 2l10 10L22 2" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </p>
  </section>

  <section class="shell section">
    <div class="section-head">
      <div class="section-head__text">
        <p class="eyebrow">Projects</p>
        <h2>Software and reference designs for resin printing</h2>
        <p class="lede">
          Everything we build is public - a slicer, a printer frontend and backend, file conversion tools, and the
          plugins that connect them to real hardware.
        </p>
      </div>
      <a class="btn btn--ghost btn--sm" href="/projects">All <span data-live="repos">{stats.totals.repos}</span> repositories</a>
    </div>

    <div class="grid grid--3">
      {FEATURED_PROJECTS.map((project) => <ProjectCard project={project} />)}
    </div>

    <div class="plugin-strip">
      <p class="plugin-strip__label mono">DragonFruit plugins</p>
      <ul class="plugin-strip__list">
        {
          PLUGIN_PROJECTS.map((plugin) => (
            <li>
              <a href={`/projects/${projectSlug(plugin)}`}>{plugin.name}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="shell section">
    <div class="section-head">
      <div class="section-head__text">
        <p class="eyebrow">By the numbers</p>
        <h2>Built in the open</h2>
        <p class="lede">
          Open issues, pull requests and commits for our core projects, read from the GitHub API. Counts are refreshed
          on every deploy and nightly; the stars and push dates on the cards above refresh live in your browser.
        </p>
      </div>
      <a class="btn btn--ghost btn--sm" href="/projects">All projects</a>
    </div>

    <StatsTable />
  </section>

  <section class="shell section">
    <div class="section-head">
      <div class="section-head__text">
        <p class="eyebrow">Blog</p>
        <h2>Notes from the workshop</h2>
        <p class="lede">Release notes, project write-ups and how we ship open-source hardware software.</p>
      </div>
      <a class="btn btn--ghost btn--sm" href="/blog">All posts</a>
    </div>

    <div class="grid grid--3">
      {latestPosts.map((post) => <PostCard post={post} withDescription={false} />)}
    </div>
  </section>

  <section class="shell section">
    <div class="section-head">
      <div class="section-head__text">
        <p class="eyebrow">Supporters</p>
        <h2>Open Collective backers</h2>
        <p class="muted">
          Fiscally hosted by{' '}
          <a class="link" href={supporters.host?.url ?? collectiveUrl} rel="noopener noreferrer" target="_blank">
            {supporters.host?.name ?? 'Open Source Collective'}
          </a>.
        </p>
      </div>
      <a class="btn btn--ghost btn--sm" href={collectiveUrl} rel="noopener noreferrer" target="_blank">
        Become a backer
      </a>
    </div>

    <ul class="backers" data-live-list="backers">
      {
        supporters.backers.map((backer) => (
          <li>
            <a href={backer.url ?? collectiveUrl} rel="noopener noreferrer" target="_blank">
              {backer.imageUrl && (
                <img src={backer.imageUrl} alt="" width="32" height="32" loading="lazy" decoding="async" />
              )}
              <span>
                <strong>{backer.name}</strong>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="shell section">
    <div class="cta">
      <div class="cta__text">
        <h2>Get involved</h2>
        <p>
          Contributions, bug reports and hardware testing are all welcome. Join the Discord to talk to the people
          building this, or pick up an issue on GitHub and open a pull request.
        </p>
      </div>
      <div class="btn-row">
        <a class="btn btn--discord" href={LINKS.discord} rel="noopener noreferrer" target="_blank"><DiscordIcon size={16} />Join the Discord</a>
        <a class="btn btn--primary" href="/contact">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // The hero holds the first screen and gives it back: as the reader scrolls, the
  // hero rises and fades while the page after it comes up into the space, which is
  // what turns a long page into one that opens. It is an enhancement in both
  // directions - without a script the hero is a full-height opening band that
  // scrolls away like any other, and under `prefers-reduced-motion` it stays that
  // way too, because that preference is about the reader's eyes, not about whether
  // scripts run.
  //
  // The element is looked up on every pass rather than held: the Router swaps the
  // document, and this script can outlive the hero it started with.
  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)');
  /** How far the reader scrolls, as a fraction of the hero's own height, to finish. */
  const HERO_TRAVEL = 0.7;
  /** How long a jump swallows the rest of the gesture that started it. */
  const JUMP_MS = 900;
  let heroHeight = 0;
  let swallowUntil = 0;

  function hero(): HTMLElement | null {
    return document.querySelector<HTMLElement>('[data-hero]');
  }

  function apply() {
    const element = hero();
    if (!element) return;

    if (REDUCED.matches) {
      document.documentElement.removeAttribute('data-hero-pinned');
      element.style.removeProperty('--hero-recede');
      element.removeAttribute('data-hidden');
      return;
    }

    document.documentElement.setAttribute('data-hero-pinned', '');
    const travel = heroHeight * HERO_TRAVEL;
    const recede = travel > 0 ? Math.min(1, Math.max(0, window.scrollY / travel)) : 0;
    element.style.setProperty('--hero-recede', recede.toFixed(3));
    // Once it is more than half gone the hero is a ghost: it keeps its links out of
    // the way of the content that has arrived on top of it.
    element.toggleAttribute('data-hidden', recede > 0.5);
  }

  function measure() {
    const element = hero();
    // The layout height, not the painted one: the transform must not change how
    // long the hero is pinned for.
    heroHeight = element ? element.offsetHeight : 0;
    apply();
  }

  /**
   * Where the opening rests, and where the reader is asking to be when they leave
   * the hero: the content's own top, less the height of the header it has to clear.
   *
   * The document's `scroll-padding-top` is not used here, and that is deliberate: it
   * is sized for landing *on a heading*, which has no space of its own above it. A
   * section does - it opens with its own padding - so clearing the header is the
   * whole of what this jump owes, and the air under the heading is the rhythm the
   * rest of the page already has.
   *
   * Measured from the content rather than from the hero, because the hero is sticky
   * while this runs and a sticky element reports where it is being held, not where it
   * sits in the page.
   */
  function stops(): { top: number; land: number } | null {
    const element = hero();
    const content = element?.nextElementSibling;
    if (!element || !content) return null;
    const top = Math.round(content.getBoundingClientRect().top + window.scrollY);
    if (top <= 0) return null;
    const header = document.querySelector('[data-site-header]');
    const clear = header ? header.getBoundingClientRect().height : 0;
    return { top, land: Math.max(0, top - Math.round(clear)) };
  }

  function jumpTo(target: number) {
    swallowUntil = performance.now() + JUMP_MS;
    window.scrollTo(0, target);
  }

  /**
   * The opening has two places to be - the hero, and the page under it - and no
   * useful in-between, so a gesture that would leave one for the other is spent on
   * the whole of the move. Which way it goes is the reader's: below the landing
   * point a scroll down carries them into the content, above it a scroll up puts
   * the hero back. Everything else scrolls as it always did.
   */
  function away(direction: 'forward' | 'back'): boolean {
    const at = stops();
    if (!at || REDUCED.matches) return false;
    const y = window.scrollY;
    if (direction === 'forward' && y < at.land - 1) {
      jumpTo(at.land);
      return true;
    }
    if (direction === 'back' && y > 1 && y <= at.land + 1) {
      jumpTo(0);
      return true;
    }
    return false;
  }

  /* A wheel event is the gesture itself, so it is the one place where saying "no" is
     what makes the jump land where the reader expects: the rest of the same flick is
     swallowed, and the page travels in one movement rather than two. */
  window.addEventListener(
    'wheel',
    (event) => {
      if (event.deltaY === 0) return;
      if (performance.now() < swallowUntil) {
        event.preventDefault();
        return;
      }
      if (away(event.deltaY > 0 ? 'forward' : 'back')) event.preventDefault();
    },
    { passive: false },
  );

  document.addEventListener('keydown', (event) => {
    const target = event.target;
    // Space and Enter are how a focused button is pressed; that is not a scroll.
    if (target instanceof Element && target.closest('a, button, input, textarea, select, [contenteditable]')) return;
    const forward = ['ArrowDown', 'PageDown', ' '].includes(event.key);
    const back = ['ArrowUp', 'PageUp'].includes(event.key);
    if (!forward && !back) return;
    if (away(forward ? 'forward' : 'back')) event.preventDefault();
  });

  /* Touch scrolls naturally - a finger on the glass is not a gesture to interrupt -
     and the page settles onto whichever side the finger was heading for when it
     lifts, unless the drag had already carried past the opening. */
  let touchedAt = 0;

  window.addEventListener(
    'touchstart',
    () => {
      touchedAt = window.scrollY;
    },
    { passive: true },
  );

  window.addEventListener('touchend', () => {
    const moved = window.scrollY - touchedAt;
    if (moved > 0 && away('forward')) return;
    if (moved < 0) away('back');
  });

  window.addEventListener('scroll', apply, { passive: true });
  window.addEventListener('resize', measure);
  REDUCED.addEventListener('change', measure);
  document.addEventListener('astro:page-load', measure);
  measure();
</script>

<style>
  /* The opening screen: the hero is as tall as the viewport and its copy sits in
     the middle of it, so the page starts with one thing rather than with the top
     of five. `--hero-recede` is written by the script above; at 0 it does nothing
     at all, which is the whole of the no-script and reduced-motion state. */
  .hero {
    --hero-recede: 0;
    position: relative;
    display: grid;
    align-content: center;
    /* One screen, less the header that sits above it in flow: the hero's own bottom
       edge is the fold, so the hint at its foot is on screen and the next section
       is not. */
    min-block-size: calc(100svh - var(--header-block-size));
    opacity: calc(1 - var(--hero-recede) * 1.15);
    transform: translateY(calc(var(--hero-recede) * -55%)) scale(calc(1 - var(--hero-recede) * 0.06));
  }

  /* Pinned to the top of the viewport while the page comes up over it. Sticky
     rather than fixed so it stays in flow: the sections below keep their place,
     and the pin ends with the hero's own box. */
  :global(html[data-hero-pinned]) .hero {
    position: sticky;
    top: 0;
  }

  .hero[data-hidden] {
    pointer-events: none;
  }

  .hero__hint {
    position: absolute;
    inset-inline: 0;
    bottom: clamp(1.75rem, 4.5vh, 3.25rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--muted);
    /* Gone in the first third of the scroll, before it can be in the way of the
       content arriving underneath it. */
    opacity: clamp(0, calc(1 - var(--hero-recede, 0) * 3), 1);
  }

  /* The chevron is the part that has to be noticed, so it carries the accent and
     the motion: a pulse downwards, in place, rather than a drift. */
  .hero__chevron {
    inline-size: 1.5rem;
    block-size: 0.9375rem;
    color: var(--accent);
    animation: hero-hint 1.9s ease-in-out infinite;
  }

  @keyframes hero-hint {
    0%,
    100% {
      transform: translateY(-2px) scale(0.94);
      opacity: 0.5;
    }
    50% {
      transform: translateY(3px) scale(1.06);
      opacity: 1;
    }
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    /* Centred hero: the column spans the content box so the heading, lede and
       buttons centre on the same axis. */
    align-items: center;
    inline-size: 100%;
    text-align: center;
  }

  .hero__copy h1 {
    margin: 0;
    /* Full width: without this the flex column shrinks the heading to its own
       text width, so it never lines up with the content below. */
    inline-size: 100%;
  }

  .section {
    padding-block: 3.5rem;
  }

  /* The first section stands where a page head stands on every other page, so it opens
     with that block's space rather than with the section rhythm: the jump out of the
     hero then lands its heading the same distance below the header as it does on
     Projects, Blog or Specs. */
  .hero + .section {
    padding-block-start: clamp(2.5rem, 2rem + 3vw, 4rem);
  }

  .section + .section {
    padding-block-start: 1rem;
  }

  .plugin-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.65rem 1.1rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .plugin-strip__label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted-2);
  }

  .plugin-strip__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9375rem;
  }

  /* Plugin names read as a list of parts, not as prose: muted at rest, ink on
     hover, and deliberately not the accent a hyperlink wears. */
  .plugin-strip__list a {
    color: var(--muted);
    transition: color 0.15s var(--ease);
  }

  .plugin-strip__list a:hover {
    color: var(--ink);
  }

  /* Supporters block: backer cards under the section head. */
  .backers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 0.6rem;
    inline-size: 100%;
  }

  .backers a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    block-size: 100%;
    padding: 0.6rem 0.7rem;
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-shadow);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    transition: border-color 0.18s var(--ease), transform 0.18s var(--ease);
  }

  .backers a:hover {
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }

  .backers img {
    inline-size: 2rem;
    block-size: 2rem;
    border-radius: 999px;
    background: var(--bg-inset);
    object-fit: cover;
    flex: 0 0 auto;
  }

  /* The text box next to the avatar. A flex item needs overflow-based or
     explicit min-inline-size so a long name ellipsises instead of pushing the
     card wider. */
  .backers span {
    display: flex;
    min-inline-size: 0;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .backers strong {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
    padding: 2rem 2.25rem;
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-shadow);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
  }

  .cta__text {
    max-width: var(--measure);
  }

  .cta__text h2 {
    margin-bottom: 0.5rem;
  }

  .cta__text p {
    color: var(--muted);
  }

  @media (max-width: 34rem) {
    .cta {
      padding: 1.5rem 1.25rem;
    }
  }
</style>
