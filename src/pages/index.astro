---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import ActivityFeed from '../components/ActivityFeed.astro';

import DiscordIcon from '../components/DiscordIcon.astro';
import { getCollection } from 'astro:content';
import { FEATURED_PROJECTS, PLUGIN_PROJECTS, projectSlug } from '../data/projects';
import { LINKS, SITE } from '../data/site';
import { stats } from '../lib/stats';
import { collectiveUrl, supporters } from '../lib/supporters';
import { formatAmount } from '../lib/format';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPosts = posts.slice(0, 3);

---

<BaseLayout description={SITE.description}>
  <section class="hero">
    <div class="shell">
      <div class="hero__copy">
        <h1>
          Advancing Open Source<br />
          <span class="text-brand">Resin 3D Printing</span>
        </h1>
        <p class="lede">
          We are a group of hobbyists and developers from around the globe, joined in our dedication to advancing
          the field of resin-based 3D printing through open source collaboration.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/projects">Explore our projects</a>
          <a class="btn btn--discord" href={LINKS.discord} rel="noopener noreferrer" target="_blank">
            <DiscordIcon size={16} />Join the Discord
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="shell section">
    <div class="section-head">
      <div class="section-head__text">
        <p class="eyebrow">Projects</p>
        <h2>Software and reference designs for resin printing</h2>
        <p class="lede">
          Everything we build is public — a slicer, a printer frontend and backend, file conversion tools, and the
          plugins that connect them to real hardware.
        </p>
      </div>
      <a class="btn btn--ghost btn--sm" href="/projects">All <span data-live="repos">{stats.totals.repos}</span> repositories</a>
    </div>

    <div class="grid grid--2">
      {FEATURED_PROJECTS.map((project) => <ProjectCard project={project} />)}
    </div>

    <div class="plugin-strip">
      <p class="plugin-strip__label mono">DragonFruit plugins</p>
      <ul class="plugin-strip__list">
        {
          PLUGIN_PROJECTS.map((plugin) => (
            <li>
              <a href={`/projects/${projectSlug(plugin)}`}>{plugin.name}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="shell section">
    <div class="section-head">
      <div class="section-head__text">
        <p class="eyebrow">Recent activity</p>
        <h2>Built in the open</h2>
        <p class="lede">
          Issues, pull requests and commits straight from the organisation&apos;s public GitHub activity — releases are
          listed on each project page.
        </p>
      </div>
    </div>

    <ActivityFeed entries={stats.activity} limit={5} />
  </section>

  <section class="shell section">
    <div class="section-head">
      <div class="section-head__text">
        <p class="eyebrow">Blog</p>
        <h2>Notes from the workshop</h2>
        <p class="lede">Release notes, project write-ups and how we ship open-source hardware software.</p>
      </div>
      <a class="btn btn--ghost btn--sm" href="/blog">All posts</a>
    </div>

    <div class="grid grid--3">
      {latestPosts.map((post) => <PostCard post={post} withDescription={false} />)}
    </div>
  </section>

  <section class="shell section">
    <div class="supporters">
      <p class="eyebrow">Supporters</p>
        <h2>Open Collective backers</h2>
        <p class="muted">
          Fiscally hosted by {supporters.host?.name ?? 'Open Source Collective'}.{' '}
          <span data-live="raised">{formatAmount(supporters.totals.raised, supporters.totals.currency)}</span> contributed by{' '}
          <span data-live="backers">{supporters.totals.backers}</span> backers so far.
        </p>
        <ul class="backers">
          {
            supporters.backers.map((backer) => (
              <li>
                <a href={backer.url ?? collectiveUrl} rel="noopener noreferrer" target="_blank">
                  {backer.imageUrl && (
                    <img src={backer.imageUrl} alt="" width="32" height="32" loading="lazy" decoding="async" />
                  )}
                  <span>
                    <strong>{backer.name}</strong>
                    <span class="muted">
                      {backer.recurring && backer.recurringAmount
                        ? `Monthly · ${formatAmount(backer.recurringAmount, backer.currency)}/mo`
                        : `One-time · ${formatAmount(backer.amount, backer.currency)}`}
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="btn-row">
          <a class="btn btn--ghost btn--sm" href={collectiveUrl} rel="noopener noreferrer" target="_blank">
            Become a backer
          </a>
          {
            supporters.host && (
              <a class="btn btn--ghost btn--sm" href={supporters.host.url ?? collectiveUrl} rel="noopener noreferrer" target="_blank">
                {supporters.host.name}
              </a>
            )
          }
        </div>
        <p class="muted supporters__note">
          Names, avatars and amounts are read from Open Collective at build time; incognito contributors are never
          published.
        </p>
    </div>
  </section>

  <section class="shell section">
    <div class="cta">
      <div class="cta__text">
        <h2>Get involved</h2>
        <p>
          Contributions, bug reports and hardware testing are all welcome. Join the Discord to talk to the people
          building this, or pick up an issue on GitHub and open a pull request.
        </p>
      </div>
      <div class="btn-row">
        <a class="btn btn--discord" href={LINKS.discord} rel="noopener noreferrer" target="_blank"><DiscordIcon size={16} />Join the Discord</a>
        <a class="btn btn--ghost" href="/contact">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    /* With the eyebrow gone the heading is the first thing under the header, so
       the top gap carries the whole opening breath: ~74px on desktop, down from
       the original 96px and up from the 55px that followed the eyebrow removal. */
    padding-block: clamp(2.5rem, 1.9rem + 3vw, 5rem) clamp(2.5rem, 2rem + 3vw, 4rem);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    /* Centred hero: the column spans the content box so the heading, lede and
       buttons centre on the same axis. */
    align-items: center;
    inline-size: 100%;
    text-align: center;
  }

  .hero__copy h1 {
    margin: 0;
    /* Full width: without this the flex column shrinks the heading to its own
       text width, so it never lines up with the content below. */
    inline-size: 100%;
  }

  .section {
    padding-block: 3.5rem;
  }

  .section + .section {
    padding-block-start: 1rem;
  }

  .plugin-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.65rem 1.1rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .plugin-strip__label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted-2);
  }

  .plugin-strip__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9375rem;
  }

  .plugin-strip__list a {
    color: var(--muted);
    transition: color 0.15s var(--ease);
  }

  .plugin-strip__list a:hover {
    color: var(--ink);
  }








  /* Supporters block: eyebrow, copy, backer cards, actions. */
  .supporters {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  /* Backer cards: avatar, name, and how they contribute. */
  .backers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 0.6rem;
    inline-size: 100%;
  }

  .backers a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    block-size: 100%;
    padding: 0.6rem 0.7rem;
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-shadow);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    transition: border-color 0.18s var(--ease), transform 0.18s var(--ease);
  }

  .backers a:hover {
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }

  .backers img {
    inline-size: 2rem;
    block-size: 2rem;
    border-radius: 999px;
    background: var(--bg-inset);
    object-fit: cover;
    flex: 0 0 auto;
  }

  .backers span {
    display: flex;
    flex-direction: column;
    min-inline-size: 0;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .backers strong {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .backers .muted {
    font-size: 0.75rem;
  }

  .supporters__note {
    font-size: 0.75rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
    padding: 2rem 2.25rem;
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-shadow);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
  }

  .cta__text {
    max-width: 62ch;
  }

  .cta__text h2 {
    margin-bottom: 0.5rem;
  }

  .cta__text p {
    color: var(--muted);
  }

  @media (max-width: 34rem) {
    .cta {
      padding: 1.5rem 1.25rem;
    }
  }
</style>
