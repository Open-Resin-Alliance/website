---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LINKS, SITE } from '../data/site';
import { FEATURED_PROJECTS, repoUrl } from '../data/projects';

const channels = [
  {
    title: 'Discord',
    description:
      'The fastest way to reach the team. Ask questions, share a print, report a bug, or follow work in progress.',
    action: 'Join the server',
    href: LINKS.discord,
    detail: 'discord.gg/beFeTaPH6v',
  },
  {
    title: 'GitHub issues',
    description:
      'Bug reports and feature requests belong on the repository they concern. Each project lists its own issue tracker.',
    action: 'Open an issue',
    href: `${repoUrl('DragonFruit')}/issues`,
    detail: 'github.com/Open-Resin-Alliance',
  },
  {
    title: 'Email',
    description:
      'For anything that does not belong in public: licensing questions, partnership enquiries, or press.',
    action: 'Send an email',
    href: LINKS.email,
    detail: SITE.email,
  },
];

const structuredData = [
  {
    '@type': 'ContactPage',
    name: 'Contact - Open Resin Alliance',
    url: 'https://openresin.org/contact',
    description: 'How to reach the Open Resin Alliance: Discord, GitHub and email.',
    isPartOf: { '@id': 'https://openresin.org/#website' },
  },
];
---

<BaseLayout
  title="Contact"
  description="Reach the Open Resin Alliance on Discord, through GitHub issues, or by email at github@openresin.org."
  structuredData={structuredData}
>
  <section class="shell page-head">
    <p class="eyebrow">Contact</p>
    <h1>Get in touch</h1>
    <p class="lede">
      We are a volunteer collective, so there is no support desk and no response-time promise. In practice Discord is
      the fastest route, and a well-written GitHub issue is the most reliable one.
    </p>
  </section>

  <section class="shell section">
    <div class="grid grid--3">
      {
        channels.map((channel) => (
          <div class="card channel">
            <div class="channel__head">
              <h2>{channel.title}</h2>
              <span class="mono channel__detail">{channel.detail}</span>
            </div>
            <p>{channel.description}</p>
            <a
              class="btn btn--ghost btn--sm channel__action"
              href={channel.href}
              {...channel.href.startsWith('http') ? { rel: 'noopener noreferrer', target: '_blank' } : {}}
            >
              {channel.action}
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <section class="shell section">
    <div class="split">
      <div>
        <h2>Before you write</h2>
        <p class="muted">
          A few things that make a report or a question much easier to act on:
        </p>
        <ul class="bullets">
          <li>Name the project and the version or release tag you are running, including whether it is a dev or nightly build.</li>
          <li>Describe the printer, the resin, and the file you were working with.</li>
          <li>For a bug, include the exact steps that reproduce it and the output you got instead of the output you expected.</li>
          <li>For a slicer issue, a copy of the model or at least a screenshot of the plate usually saves a round trip.</li>
        </ul>
      </div>

      <div class="aside">
        <h2>Where to file what</h2>
        <ul class="aside__list">
          {
            FEATURED_PROJECTS.map((project) => (
              <li>
                <a href={`${repoUrl(project.repo)}/issues`} rel="noopener noreferrer" target="_blank">
                  <strong>{project.name}</strong>
                  <span class="muted">{project.blurb}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="muted aside__note">
          Plugins live in their own repositories, so a printer-specific problem is usually best filed against the
          plugin rather than the slicer itself.
        </p>
      </div>
    </div>
  </section>

  <section class="shell section">
    <div class="org">
      <div>
        <h2 class="mono org__title">Organisation details</h2>
        <dl class="org__list">
          <div><dt>Name</dt><dd>{SITE.name} ({SITE.shortName})</dd></div>
          <div><dt>Established</dt><dd>{SITE.founded}</dd></div>
          <div><dt>Website</dt><dd>{SITE.url.replace('https://', '')}</dd></div>
          <div><dt>General email</dt><dd><a href={LINKS.email}>{SITE.email}</a></dd></div>
          <div><dt>GitHub</dt><dd><a href={LINKS.github} rel="noopener noreferrer" target="_blank">github.com/Open-Resin-Alliance</a></dd></div>
          <div><dt>Discord</dt><dd><a href={LINKS.discord} rel="noopener noreferrer" target="_blank">discord.gg/beFeTaPH6v</a></dd></div>
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    padding-block: clamp(2.5rem, 2rem + 3vw, 4rem) 0;
  }

  .page-head .lede {
    max-width: 68ch;
  }

  .section {
    padding-block: 3rem 0;
  }

  .channel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.4rem 1.5rem;
  }

  .channel__head {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .channel h2 {
    font-size: 1.0625rem;
  }

  .channel__detail {
    font-size: 0.6875rem;
    color: var(--muted-2);
    overflow-wrap: anywhere;
  }

  .channel p {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.65;
    flex: 1 1 auto;
  }

  .channel__action {
    align-self: flex-start;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
  }

  .split h2 {
    font-size: 1.25rem;
    margin-bottom: 0.85rem;
  }

  .bullets {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    max-width: 68ch;
  }

  .bullets li {
    position: relative;
    padding-left: 1.15rem;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6rem;
    inline-size: 5px;
    block-size: 5px;
    border-radius: 999px;
    background: var(--brand-pink);
  }

  .aside__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .aside__list a {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.8rem 0.95rem;
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-shadow);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    font-size: 0.9375rem;
    transition: border-color 0.18s var(--ease), transform 0.18s var(--ease);
  }

  .aside__list a:hover {
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }

  .aside__list span {
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .aside__note {
    margin-top: 1rem;
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .org {
    padding: 2rem 2.25rem;
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-shadow);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
  }

  .org__title {
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted-2);
    margin-bottom: 1.25rem;
  }

  .org__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1rem 2.5rem;
    margin: 0;
  }

  .org__list > div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.9375rem;
  }

  .org__list dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-2);
    padding-top: 0.2rem;
  }

  .org__list dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .org__list a {
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 2px;
  }

  .org__list a:hover {
    text-decoration-color: var(--brand-pink);
  }

  @media (max-width: 960px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .org {
      padding: 1.5rem 1.25rem;
    }
  }
</style>
