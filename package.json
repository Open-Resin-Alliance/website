    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.3.2",
    "satori": "^0.33.4",
    "satori-html": "^0.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild": true
