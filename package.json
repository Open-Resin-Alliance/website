{
  "name": "openresin-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "openresin.org - the Open Resin Alliance website",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
